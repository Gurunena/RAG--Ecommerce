# Product and avatar images land here from user uploads. Images must be served,
# but nothing in this folder may ever be EXECUTED, however it got named.
# (api/helpers.php also renames every upload to a random name + safe extension,
# so this file is the second lock, not the only one.)

# 1. Strip every handler that could run code, and serve such files as text.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pht .shtml .cgi .pl
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pht
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pht .cgi .pl

# 2. Belt and braces: turn the PHP engine off outright where mod_php is loaded.
<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# 3. Only real image types are served at all; everything else is denied.
<FilesMatch "(?i)\.(jpe?g|png|webp|gif)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
<FilesMatch "(?i)^(?!.*\.(jpe?g|png|webp|gif)$).*$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -ExecCGI -Indexes
